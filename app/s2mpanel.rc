#include <winuser.h>
#include <winver.h>
#include "../driver/version.h"
1 RT_MANIFEST "s2mpanel.manifest"
1 ICON "s2mpanel.ico"
// Toolbar icons (make_toolicons.py): reset all settings, export, import.
10 ICON "reset.ico"
11 ICON "export.ico"
12 ICON "import.ico"
13 ICON "mixer.ico"
14 ICON "clear.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     S2M_VER_MAJOR, S2M_VER_MINOR, S2M_VER_BUILD, S2M_VER_REV
PRODUCTVERSION  S2M_VER_MAJOR, S2M_VER_MINOR, S2M_VER_BUILD, S2M_VER_REV
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      S2M_AUTHOR
            VALUE "LegalCopyright",   S2M_COPYRIGHT
            VALUE "FileDescription",  "Speak2Mic control panel"
            VALUE "FileVersion",      S2M_VER_STR
            VALUE "InternalName",     "Speak2Mic"
            VALUE "OriginalFilename", "Speak2Mic.exe"
            VALUE "ProductName",      "Speak2Mic"
            VALUE "ProductVersion",   S2M_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
